<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Menu - <%= storeCode %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container py-5">
        <a href="/" class="btn btn-outline-dark mb-4">⬅ Kembali ke Daftar Toko</a>
        <h2 class="mb-4">☕ Menu di Toko: <%= storeCode %></h2>
        
        <% menuGroups.forEach(kategori => { %>
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-dark text-white fw-bold">
                <%= kategori.group_name %>
            </div>
            <ul class="list-group list-group-flush">
                <% kategori.menu_products.forEach(item => { %>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <span class="fw-semibold"><%= item.name %></span><br>
                        <small class="text-muted">Rp <%= item.price.toLocaleString('id-ID') %></small>
                    </div>
                    <% if (item.is_sold_out) { %>
                        <span class="badge bg-danger rounded-pill">Habis</span>
                    <% } else { %>
                        <span class="badge bg-success rounded-pill">Tersedia</span>
                    <% } %>
                </li>
                <% }) %>
            </ul>
        </div>
        <% }) %>
    </div>
</body>
</html>